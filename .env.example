NODE_ENV=development
PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/camply
CLIENT_ORIGIN=http://localhost:5173
SESSION_TTL_DAYS=30
SESSION_REFRESH_THRESHOLD_HOURS=24
# Only needed to run `npm run seed:org` (creates the first organization account).
# The org logs in by username, not phone. Dev defaults: admin / 1234.
SEED_ORG_USERNAME=admin
SEED_ORG_PASSWORD=1234
