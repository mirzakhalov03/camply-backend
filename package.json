{
  "name": "backend",
  "version": "1.0.0",
  "description": "Camply API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon",
    "seed:org": "tsx src/scripts/seedOrg.ts",
    "seed:participants": "tsx src/scripts/seedParticipants.ts",
    "build": "tsc && mkdir -p dist/emails/assets && cp src/emails/assets/* dist/emails/assets/",
    "promote:creators": "tsx src/scripts/promoteCampCreators.ts",
    "start": "node dist/server.js",
    "lint": "oxlint src",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "validate": "npm run lint && npm run format:check && npm run typecheck",
    "prepare": "husky",
    "seed:demo": "tsx src/scripts/seedDemoCamp.ts",
    "migrate:drop-checkin": "tsx src/scripts/dropCheckin.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^8.5.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "mongoose": "^9.7.3",
    "nodemailer": "^9.0.3",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.0",
    "@types/nodemailer": "^8.0.1",
    "@types/swagger-ui-express": "^4.1.8",
    "husky": "^9.1.7",
    "nodemon": "^3.1.14",
    "oxlint": "^1.72.0",
    "prettier": "^3.9.4",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3"
  }
}